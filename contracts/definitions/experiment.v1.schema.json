{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "motion-control-lab/experiment.v1",
  "title": "Motion Control Lab experiment definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "title",
    "question",
    "hypothesis",
    "independent_factors",
    "controlled_factors",
    "allowed_differences",
    "inputs",
    "arms",
    "evaluation_windows",
    "metrics",
    "comparisons",
    "failure_policy",
    "artifact_requirements"
  ],
  "properties": {
    "schema_version": {
      "const": "experiment.v1"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^E[0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "independent_factors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "controlled_factors": {
      "type": "object"
    },
    "allowed_differences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "input_id",
          "artifact",
          "required"
        ],
        "properties": {
          "input_id": {
            "type": "string",
            "minLength": 1
          },
          "artifact": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "arms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "arm_id",
          "method",
          "required"
        ],
        "properties": {
          "arm_id": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "evaluation_windows": {
      "type": "array",
      "minItems": 1
    },
    "metrics": {
      "type": "object",
      "required": [
        "primary",
        "secondary",
        "guardrail",
        "diagnostic"
      ]
    },
    "comparisons": {
      "type": "array"
    },
    "failure_policy": {
      "type": "object"
    },
    "artifact_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}

