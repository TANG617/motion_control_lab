{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "analysis_id",
    "analysis_directory",
    "phase",
    "campaign",
    "sources",
    "source_policy",
    "statistics",
    "display",
    "expected_units",
    "pairing"
  ],
  "properties": {
    "schema_version": {
      "const": "analysis.v1"
    },
    "analysis_id": {
      "enum": [
        "A01",
        "A02"
      ]
    },
    "analysis_directory": {
      "type": "string",
      "pattern": "^A0[12]_[a-z_]+$"
    },
    "phase": {
      "const": "development"
    },
    "campaign": {
      "type": "object",
      "required": [
        "plan",
        "status",
        "execution_index"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "locator",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "locator": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "experiment_id",
          "run_id",
          "run_dir",
          "manifest",
          "inventory"
        ],
        "properties": {
          "experiment_id": {
            "type": "string",
            "pattern": "^E[0-9]{2}$"
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "run_dir": {
            "type": "string",
            "minLength": 1
          },
          "manifest": {
            "type": "object",
            "required": [
              "locator",
              "sha256",
              "size_bytes"
            ],
            "properties": {
              "locator": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "inventory": {
            "type": "object",
            "required": [
              "locator",
              "sha256",
              "size_bytes"
            ],
            "properties": {
              "locator": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "expected_units": {
      "type": "integer",
      "minimum": 1
    },
    "admission_source": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "manifest",
            "parity_table",
            "pair_admission"
          ],
          "properties": {
            "manifest": {
              "type": "object",
              "required": [
                "locator",
                "sha256",
                "size_bytes"
              ],
              "properties": {
                "locator": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "parity_table": {
              "type": "object",
              "required": [
                "locator",
                "sha256",
                "size_bytes"
              ],
              "properties": {
                "locator": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "pair_admission": {
              "type": "object",
              "required": [
                "locator",
                "sha256",
                "size_bytes"
              ],
              "properties": {
                "locator": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "statistics": {
      "type": "object",
      "required": [
        "bootstrap",
        "significance_tests"
      ]
    },
    "source_policy": {
      "type": "object",
      "required": [
        "allowed_statuses"
      ]
    },
    "display": {
      "type": "object"
    },
    "pairing": {
      "type": "object"
    }
  }
}
