{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "question",
    "units",
    "failure_policy",
    "metrics",
    "evaluation_windows",
    "controlled_factors"
  ],
  "properties": {
    "experiment_id": {
      "pattern": "^E[0-9]{2}$"
    },
    "units": {
      "type": "array",
      "minItems": 1
    },
    "schema_version": {
      "const": "experiment.v2"
    }
  }
}
