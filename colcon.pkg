{
  "name": "motion_control_lab",
  "type": "cmake",
  "dependencies": [
    "motion_control_core",
    "motion_control_viz"
  ],
  "cmake-args": [
    "-DMCL_BUILD_SINGLE_ARM_SERVO_STEP=ON",
    "-DMCL_BUILD_SERVO_STEP=ON",
    "-DMCL_BUILD_TARGET_SOLVE=ON",
    "-DMCL_BUILD_GROUPED_SERVO_STEP=ON",
    "-DMCL_BUILD_PLANNED_GROUPED_SERVO_STEP=ON",
    "-DMCL_BUILD_E03_REPLAY_VISUALIZATION=ON",
    "-DMCL_BUILD_MCC_PLOTS=OFF",
    "-DMCL_BUILD_CARTESIAN_PLANNING=OFF"
  ]
}
