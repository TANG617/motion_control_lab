{
  "name": "motion_control_lab",
  "type": "cmake",
  "dependencies": [
    "motion_control_core",
    "motion_control_sim",
    "motion_control_viz"
  ],
  "cmake-args": [
    "-DMCL_BUILD_STEP=ON",
    "-DMCL_BUILD_TARGET=ON",
    "-DMCL_BUILD_BASELINE=ON",
    "-DMCL_BUILD_HIERARCHICAL_KINEMATICS_STEP=ON"
  ]
}
