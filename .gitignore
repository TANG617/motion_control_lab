# CMake build trees
/build/
/build-*/
/out/

# Local editor and OS files
.DS_Store
.cache/
.idea/
.vscode/

# Colcon-generated logs
/log/

# Python tooling caches
__pycache__/
*.py[cod]

# Experiment workspaces are append-only local evidence, not source files.
/experiments/*/runs/*
!/experiments/*/runs/.gitkeep

# Promoted results are added deliberately after review.
/experiments/*/results/*
!/experiments/*/results/.gitkeep

# Study execution evidence and locally prepared inputs. Keep generators,
# declarations, recipes and input contracts in source control.
/runs/
/experiments/*/inputs/generated/
/experiments/*/inputs/superseded/
/experiments/*/inputs/inventory-*/
/experiments/E12_recorded_motion_holdout/inputs/required_units.json
/tools/mcc_placo_study/generator_snapshots/

# Future analysis outputs follow the same local-evidence policy.
/analyses/*/runs/*
!/analyses/*/runs/.gitkeep
/analyses/*/results/*
!/analyses/*/results/.gitkeep
